# ─── Discord ─────────────────────────────────────────────────────────────
# discord.com/developers/applications → az alkalmazásod → Bot → Reset Token
DISCORD_TOKEN=
# Jobb klikk a csatornára → Csatorna ID másolása (fejlesztői mód szükséges)
DISCORD_CHANNEL_ID=
# Nem kötelező: ebben a szerverben azonnal megjelenik a /timetable parancs
GUILD_ID=

# ─── Órarend forrása ─────────────────────────────────────────────────────
# Helyi munkafüzet: nem kell szerver, nem kell megosztás, offline is működik.
# Minden lekérdezéskor újraolvassuk, tehát elég a fájlt menteni. Ha valaki más
# frissíti, tarthatod Drive/Dropbox szinkronizált mappában is.
SOURCE_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_ID/edit?usp=sharing
#
# Helyi HTTP szerver helyette (`bun run serve` egy másik terminálban):
# SOURCE_URL=http://127.0.0.1:8787/timetable.xlsx
#
# Google Sheets / OneDrive / Dropbox MEGOSZTÁSI link, bejelentkezés nélkül olvasható:
# SOURCE_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_ID/edit
#
# OneDrive / SharePoint: csak MEGOSZTÁSI link működik (Megosztás → „Bárki, aki
# a linkkel rendelkezik”). A fiókodból másolt Doc.aspx?sourcedoc=… nézegető URL
# bejelentkezést kér, ezért a bot 403-at kap. Ha a szervezet tiltja a nyilvános
# megosztást, töltsd le a fájlt és add meg helyi útvonalként.

# ─── SharePoint / OneDrive bejelentkezés (opcionális) ────────────────────
# Ha a szervezet nem engedi a „Bárki, aki a linkkel rendelkezik” megosztást,
# a fájl csak Microsoft Graphszal olvasható (Azure-alkalmazás, ügyfél-titok):
#   1. portal.azure.com → App registrations → New registration
#   2. Certificates & secrets → New client secret
#   3. API permissions → Microsoft Graph → Application permissions:
#      Files.Read.All és Sites.Read.All → Grant admin consent
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# ─── Működés ─────────────────────────────────────────────────────────────
# Két ellenőrzés között eltelt másodpercek (15–3600)
POLL_SECONDS=60
# Ettől a naptól kezdve az alapértelmezett nézet a következő hét
ROLLOVER_WEEKDAY=szombat
# Az "ma" napot meghatározó IANA időzóna; üresen a gép zónája
TIMEZONE=Europe/Budapest
# A rögzített üzenet azonosítója újraindítás után is
STATE_FILE=.state.json
# Múlt heti órarendek, mert a táblázat csak az aktuális hetet tartalmazza
ARCHIVE_FILE=.weeks.json
# A blokkok megjelenített nevei (vesszővel, sorrendben)
BLOCK_LABELS=
